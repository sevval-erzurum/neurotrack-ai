# Kopyalayın: cp .env.example .env
ENVIRONMENT=development
DATABASE_URL=sqlite:///./neurotrack.db
# Üretimde zorunlu, en az 32 karakter: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me-dev-only-change-me
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:3000"]
# Boş bırakılırsa asistan kural tabanlı yanıtlara düşer.
GEMINI_API_KEY=
